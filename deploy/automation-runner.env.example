# Required: generate with `openssl rand -hex 32`
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Session hardening
SESSION_COOKIE_NAME=automation_runner_session
SESSION_MAX_AGE=28800
SESSION_SAME_SITE=lax
# Set true once the UI is served exclusively over HTTPS.
SESSION_HTTPS_ONLY=false

# Per-account lockout
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_ACCOUNT_LOCKOUT_MINUTES=15

# Per-IP failed-login throttling
LOGIN_IP_FAILURE_LIMIT=30
LOGIN_IP_WINDOW_MINUTES=5
LOGIN_IP_BLOCK_MINUTES=5
